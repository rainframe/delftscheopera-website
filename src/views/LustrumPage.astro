---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import StageBanner from '@/components/StageBanner.astro';
import CurtainFrame from '@/components/CurtainFrame.astro';
import DelftSkyline from '@/components/DelftSkyline.astro';
import Icon from '@/components/Icon.astro';
import bladmuziek from '@/assets/decor/bladmuziek-hoog.png';
import { alternatesFor, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { getPage, localized, md, resolvePeople } from '@/lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = await getPage('lustrum', locale);
const team = await resolvePeople(page.team);
---

<BaseLayout
  locale={locale}
  title={page.seo.title}
  description={page.seo.description}
  alternates={alternatesFor('lustrum')}
  current="lustrum"
  image={page.banner.image}
  imageAlt={page.banner.imageAlt}
>
  <StageBanner
    locale={locale}
    title={page.banner.title}
    subtitle={page.banner.subtitle}
    year={page.banner.year}
    image={page.banner.image}
    imageAlt={page.banner.imageAlt}
    credit={page.banner.credit}
    headingLevel="h1"
    eager
  />

  <section class="community" aria-labelledby="community-title">
    <Image class="community__paper" src={bladmuziek} alt="" width={480} />
    <div class="container">
      <h2 id="community-title" class="display-title community__title">
        {page.intro.title}
      </h2>
      <div class="community__text lead" set:html={md(page.intro.text)} />
    </div>
    <DelftSkyline />
  </section>

  <section class="krashna" aria-labelledby="krashna-title">
    <div class="krashna__grid container">
      <div class="krashna__text">
        <h2 id="krashna-title" class="section-heading">
          {page.krashna.title}
        </h2>
        <div class="prose" set:html={md(page.krashna.text)} />
        <a class="arrow-link krashna__link" href={page.krashna.linkUrl}>
          <span>{page.krashna.linkLabel}</span>
          <Icon name="arrow" />
        </a>
      </div>
      <CurtainFrame sides="both" tone="navy" curtainWidth="8%" class="krashna__media">
        <Image
          src={page.krashna.image}
          alt={page.krashna.imageAlt}
          widths={[480, 720, 980]}
          sizes="(min-width: 56rem) 50vw, 100vw"
        />
      </CurtainFrame>
    </div>
  </section>

  <div class="team">
    {team.map((person, index) => {
      const bio = localized(person.data.bio, locale);
      const role = localized(person.data.role, locale);
      const id = `team-${person.id}`;
      if (person.data.photo) {
        return (
          <section class="member member--feature band" aria-labelledby={id}>
            <div class="member__grid">
              <CurtainFrame sides="left" tone="navy" curtainWidth="22%" class="member__portrait">
                <Image
                  src={person.data.photo}
                  alt={`${t(locale, 'people.photoAlt')} ${person.data.name}`}
                  widths={[300, 450, 620]}
                  sizes="(min-width: 56rem) 22vw, 60vw"
                />
              </CurtainFrame>
              <div class="member__text">
                <h2 id={id} class="member__name">
                  {person.data.name}
                </h2>
                <p class="member__role">{role}</p>
                {bio && <div class="member__bio prose" set:html={md(bio)} />}
              </div>
              {person.data.workImage && (
                <Image
                  class="member__work"
                  src={person.data.workImage}
                  alt={localized(person.data.workImageAlt, locale)}
                  widths={[400, 600, 820]}
                  sizes="(min-width: 56rem) 28vw, 100vw"
                />
              )}
            </div>
          </section>
        );
      }
      return (
        <section
          class:list={['member', 'container', index % 2 === 1 ? 'member--end' : 'member--start']}
          aria-labelledby={id}
        >
          <h2 id={id} class="member__name">
            {person.data.name}
          </h2>
          <p class="member__role">{role}</p>
          {bio && <div class="member__bio prose" set:html={md(bio)} />}
        </section>
      );
    })}
  </div>
</BaseLayout>

<style>
  .section-heading {
    font-size: var(--fs-h2);
  }

  /* Community Opera */
  .community {
    position: relative;
    padding-top: clamp(2.5rem, 5vw, 4rem);
    overflow: hidden;
  }

  .community :global(.community__paper) {
    position: absolute;
    top: 0.75rem;
    right: 4%;
    width: clamp(7rem, 17.5vw, 15rem);
    height: auto;
    pointer-events: none;
  }

  .community__title {
    position: relative;
    text-align: left;
    padding-left: clamp(0rem, 9vw, 8rem);
  }

  .community__text {
    max-width: 27rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
    padding-left: clamp(0rem, 2.5vw, 2rem);
  }

  .community__text :global(p + p) {
    margin-top: 1em;
  }

  /* Krashna Musika */
  .krashna {
    padding-block: var(--space-section);
  }

  .krashna__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .krashna__text .prose {
    margin-top: 1.5rem;
  }

  .krashna__link {
    margin-top: 1.75rem;
    font-size: 1.15rem;
  }

  .krashna :global(.krashna__media) {
    aspect-ratio: 7 / 3;
  }

  /* Artistiek team */
  .member {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }

  .member__name {
    font-size: var(--fs-h2);
  }

  .member__role {
    margin-top: 0.35rem;
    font-weight: 700;
    font-size: var(--fs-lead);
  }

  .member__bio {
    margin-top: 1.25rem;
  }

  .member--end {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }

  .member--end .member__bio {
    max-width: 36rem;
  }

  .member--start .member__bio {
    max-width: 36rem;
  }

  .member--feature {
    padding-block: clamp(2.5rem, 4.5vw, 3.5rem);
    margin-block: clamp(1rem, 3vw, 2.5rem);
  }

  .member__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 3.5vw, 3.5rem);
    align-items: start;
    width: min(100% - var(--gutter), var(--wide));
    margin-left: 0;
    padding-right: var(--gutter);
  }

  .member--feature :global(.member__portrait) {
    aspect-ratio: 2 / 3;
  }

  .member--feature .member__text {
    padding-top: 0.25rem;
  }

  .member--feature :global(.member__work) {
    width: 100%;
    height: auto;
  }

  @media (max-width: 56rem) {
    .krashna__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .member__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      width: 100%;
      padding-left: 0;
    }

    .member--feature :global(.member__work) {
      grid-column: 1 / -1;
      padding-left: var(--gutter);
    }

    .community__title {
      padding-left: 0;
      padding-right: 18vw;
    }
  }

  @media (max-width: 36rem) {
    .member__grid {
      grid-template-columns: minmax(0, 1fr);
      padding-left: 0;
    }

    .member--feature :global(.member__portrait) {
      width: 70%;
      aspect-ratio: 3 / 4;
    }

    .member--feature .member__text {
      padding-left: var(--gutter);
    }
  }
</style>
