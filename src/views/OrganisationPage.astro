---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageTitle from '@/components/PageTitle.astro';
import PersonCard from '@/components/PersonCard.astro';
import InfoList from '@/components/InfoList.astro';
import { alternatesFor, pageUrl, type Locale } from '@/i18n/routes';
import { getPage, getPeople, localized, md, mdInline } from '@/lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = await getPage('organisatie', locale);
const board = await getPeople('bestuur');

// Het Comité van Aanbeveling en de Raad van Toezicht staan als namenlijst (zonder foto's) boven het
// bestuur; een groep zonder leden wordt overgeslagen.
const groups = [
  {
    id: 'recommendation',
    title: page.recommendationTitle,
    text: page.recommendationText,
    people: await getPeople('comite-van-aanbeveling'),
    band: false,
  },
  {
    id: 'supervisory',
    title: page.supervisoryTitle,
    text: page.supervisoryText,
    people: await getPeople('raad-van-toezicht'),
    band: true,
  },
].filter((group) => group.people.length > 0);
---

<BaseLayout
  locale={locale}
  title={page.seo.title}
  description={page.seo.description}
  alternates={alternatesFor('organisatie')}
  current="organisatie"
>
  <PageTitle title={page.title}>
    <div class="org-intro prose lead" set:html={md(page.intro)} />
  </PageTitle>

  <section class="org-projects band" aria-labelledby="projects-title">
    <div class="container">
      <h2 id="projects-title" class="org-heading">
        {page.projects.title}
      </h2>
      <p class="org-projects__text" set:html={mdInline(page.projects.text)} />
      <a class="org-projects__button" href={pageUrl('projecten', locale)}>
        {page.projects.linkLabel}
      </a>
    </div>
  </section>

  {groups.map((group) => (
    <section class:list={['org-group', { band: group.band }]} aria-labelledby={`${group.id}-title`}>
      <div class="container">
        <h2 id={`${group.id}-title`} class="org-heading">
          {group.title}
        </h2>
        <p class="org-group__text">{group.text}</p>
        <ul class="people-list" role="list">
          {group.people.map((person) => (
            <li>
              <h3>{person.data.name}</h3>
              <p>{localized(person.data.role, locale)}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="org-board container" aria-labelledby="board-title">
    <h2 id="board-title" class="org-heading">
      {page.boardTitle}
    </h2>
    <ul class="board-grid" role="list">
      {board.map((person) => (
        <li>
          <PersonCard person={person} locale={locale} />
        </li>
      ))}
    </ul>
  </section>

  <section class="org-info container" aria-labelledby="info-title">
    <h2 id="info-title" class="org-heading">
      {page.infoTitle}
    </h2>
    <InfoList locale={locale} />
  </section>
</BaseLayout>

<style>
  .org-intro {
    margin: clamp(2rem, 5vw, 4rem) auto 0;
    max-width: 44rem;
  }

  .org-heading {
    font-size: var(--fs-h2);
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }

  .org-group {
    padding-block: var(--space-section);
  }

  /* Een witte groep direct onder de paginatitel heeft daar al ruimte genoeg. */
  :global(.page-title) + .org-group:not(.band) {
    padding-top: 0;
  }

  /* Verwijzing naar de eerdere projecten, tussen de introductie en het Comité van Aanbeveling. */
  .org-projects {
    padding-block: var(--space-section);
  }

  .org-projects__text {
    max-width: var(--measure);
    margin-top: -0.75rem;
    font-size: var(--fs-lead);
  }

  .org-projects__button {
    display: inline-block;
    margin-top: clamp(1.5rem, 3vw, 2rem);
    padding: 0.8rem 1.4rem;
    border: 2px solid var(--white);
    background: var(--white);
    color: var(--navy);
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .org-projects__button:hover {
    background: transparent;
    color: var(--white);
  }

  .org-group__text {
    max-width: var(--measure);
    margin-top: -0.75rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    font-size: var(--fs-lead);
  }

  .people-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 2rem clamp(1.5rem, 4vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .people-list li {
    padding-top: 1rem;
    border-top: 2px solid rgb(var(--navy-rgb) / 0.35);
  }

  .band .people-list li {
    border-top-color: rgb(255 255 255 / 0.5);
  }

  .people-list h3 {
    font-size: var(--fs-h3);
  }

  .people-list p {
    margin-top: 0.35rem;
    line-height: 1.45;
  }

  .org-board {
    padding-top: var(--space-section);
  }

  .org-info {
    max-width: 56rem;
    padding-block: var(--space-section);
  }

  .board-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2.5rem, 4vw, 3.5rem) clamp(1.5rem, 4vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 56rem) {
    .board-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 30rem) {
    .board-grid {
      gap: 2rem 1rem;
    }
  }
</style>
