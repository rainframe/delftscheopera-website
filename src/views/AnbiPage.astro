---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageTitle from '@/components/PageTitle.astro';
import InfoList from '@/components/InfoList.astro';
import { alternatesFor, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { getPage, getPeople, localized, md } from '@/lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = await getPage('anbi', locale);
const board = await getPeople('bestuur');
---

<BaseLayout
  locale={locale}
  title={page.seo.title}
  description={page.seo.description}
  alternates={alternatesFor('anbi')}
>
  <PageTitle title={page.title}>
    <div class="anbi-status band" set:html={md(page.status)} />
  </PageTitle>

  <div class="anbi container">
    <p class="anbi__text lead">{page.text}</p>

    <section aria-labelledby="anbi-info">
      <h2 id="anbi-info">{t(locale, 'anbi.info')}</h2>
      <InfoList locale={locale} showAnbi={false} />
    </section>

    <section aria-labelledby="anbi-goal">
      <h2 id="anbi-goal">{page.goalTitle}</h2>
      <p>{page.goal}</p>
    </section>

    <section aria-labelledby="anbi-board">
      <h2 id="anbi-board">{t(locale, 'anbi.board')}</h2>
      <ul class="anbi__board" role="list">
        {
          board.map((person) => (
            <li>
              <strong>{localized(person.data.role, locale)}</strong>: {person.data.name}
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="anbi-documents">
      <h2 id="anbi-documents">{page.documentsTitle}</h2>
      <ul class="anbi__documents" role="list">
        {
          page.documents.map((document) => (
            <li>
              {document.url ? (
                <a href={document.url}>{document.title}</a>
              ) : (
                <>
                  {document.title}: <em>{t(locale, 'anbi.pending')}</em>
                </>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .anbi-status {
    max-width: 44rem;
    margin: clamp(2rem, 5vw, 3.5rem) auto 0;
    padding: 1.5rem 1.75rem;
    font-size: var(--fs-lead);
    line-height: 1.5;
    text-align: center;
  }

  .anbi {
    max-width: 56rem;
    padding-bottom: var(--space-section);
  }

  .anbi section {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .anbi h2 {
    font-size: var(--fs-h3);
    margin-bottom: 1.25rem;
  }

  .anbi__board,
  .anbi__documents {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
