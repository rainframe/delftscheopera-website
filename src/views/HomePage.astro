---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import StageBanner from '@/components/StageBanner.astro';
import PostCard from '@/components/PostCard.astro';
import CommunityIntro from '@/components/CommunityIntro.astro';
import KrashnaBlock from '@/components/KrashnaBlock.astro';
import Icon from '@/components/Icon.astro';
import { alternatesFor, pageUrl, type Locale } from '@/i18n/routes';
import { getPage, getPosts } from '@/lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = await getPage('home', locale);
const posts = (await getPosts(locale)).slice(0, 3);
---

<BaseLayout
  locale={locale}
  title={page.seo.title}
  description={page.seo.description}
  alternates={alternatesFor('home')}
  image={page.banner.images[0].image}
  imageAlt={page.banner.images[0].imageAlt}
  isHome
>
  <StageBanner
    locale={locale}
    title={page.banner.title}
    subtitle={page.banner.subtitle}
    images={page.banner.images}
    headingLevel="h1"
    eager
  />

  <CommunityIntro title={page.intro.title} text={page.intro.text} />

  {posts.length > 0 && (
    <section class="home-news band" aria-labelledby="home-news-title">
      <div class="container">
        <h2 id="home-news-title" class="display-title home-news__title">
          {page.news.title}
        </h2>
        <ul class="post-grid" role="list">
          {posts.map((post) => (
            <li>
              <PostCard post={post} locale={locale} tone="navy" />
            </li>
          ))}
        </ul>
        <a class="arrow-link home-news__more" href={pageUrl('nieuws', locale)}>
          <span>{page.news.moreLabel}</span>
          <Icon name="arrow" />
        </a>
      </div>
    </section>
  )}

  <KrashnaBlock {...page.krashna} />

  <Hero
    title={page.support.title}
    subtitle={page.support.subtitle}
    image={page.support.image}
    imageAlt={page.support.imageAlt}
    link={{ href: pageUrl('steunen', locale), label: page.support.linkLabel }}
    headingLevel="h2"
    eager={false}
  />
</BaseLayout>

<style>
  /* Nieuws */
  .home-news {
    padding-block: clamp(2rem, 4.5vw, 3.6rem) var(--space-section);
  }

  .home-news__title {
    margin-bottom: clamp(1.75rem, 3.5vw, 3rem);
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-news__more {
    margin-top: clamp(2rem, 4vw, 3rem);
    font-size: 1.3rem;
  }

  @media (max-width: 64rem) {
    .post-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 48rem) {
    .post-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
