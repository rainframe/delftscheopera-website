---
import '@/styles/global.css';
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import type { Alternates, Locale, RouteKey } from '@/i18n/routes';
import { htmlLang, t } from '@/i18n/ui';

interface Props {
  locale: Locale;
  /** Paginatitel; " | Delftsche Opera" wordt automatisch toegevoegd (behalve op de homepage). */
  title: string;
  description: string;
  /** Waar de taalvlaggen naartoe linken. */
  alternates: Alternates;
  /** Echte vertalingen van deze pagina (voor hreflang); standaard gelijk aan `alternates`. */
  translations?: Alternates;
  current?: RouteKey;
  /** Afbeelding voor delen op sociale media (LinkedIn e.d.). */
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  published?: Date;
  isHome?: boolean;
}

const {
  locale,
  title,
  description,
  alternates,
  translations = alternates,
  current,
  image,
  imageAlt,
  type = 'website',
  published,
  isHome = false,
} = Astro.props;

const siteName = 'Delftsche Opera';
const fullTitle = isHome ? title : `${title} | ${siteName}`;
const site = Astro.site ?? new URL('https://delftscheopera.nl');
const canonical = new URL(Astro.url.pathname, site);
const absolute = (path: string) => new URL(path, site).href;

const shareImage = image
  ? absolute((await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src)
  : absolute('/og-default.png');
const hasBothLanguages = Boolean(translations.nl && translations.en);
const rssUrl = locale === 'nl' ? '/nieuws/rss.xml' : '/en/news/rss.xml';
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {
      hasBothLanguages && (
        <>
          <link rel="alternate" hreflang="nl" href={absolute(translations.nl!)} />
          <link rel="alternate" hreflang="en" href={absolute(translations.en!)} />
          <link rel="alternate" hreflang="x-default" href={absolute(translations.nl!)} />
        </>
      )
    }

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={htmlLang[locale].replace('-', '_')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#042d64" />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} – ${t(locale, 'nav.nieuws')}`} href={rssUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Font cssVariable="--font-spartan" preload />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#inhoud">{t(locale, 'site.skip')}</a>
    <Header locale={locale} alternates={alternates} current={current} />
    <main id="inhoud">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--navy);
    color: var(--white);
    font-weight: 700;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  main {
    display: block;
  }
</style>
