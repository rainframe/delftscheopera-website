---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StageMessage from '@/components/StageMessage.astro';
import Icon from '@/components/Icon.astro';
import { alternatesFor, pageUrl } from '@/i18n/routes';
import { t } from '@/i18n/ui';
---

<BaseLayout
  locale="nl"
  title={t('nl', 'notFound.title')}
  description={t('nl', 'notFound.text')}
  alternates={alternatesFor('home')}
  standalone
>
  <StageMessage>
    <p class="not-found__code">404</p>
    <h1>{t('nl', 'notFound.title')}</h1>
    <p class="stage-message__lead">{t('nl', 'notFound.text')}</p>
    <a class="arrow-link" href={pageUrl('home', 'nl')}>
      <span>{t('nl', 'notFound.home')}</span>
      <Icon name="arrow" />
    </a>
    <div class="not-found__en" lang="en">
      <p>
        <strong>{t('en', 'notFound.title')}.</strong> {t('en', 'notFound.text')}
      </p>
      <a class="arrow-link" href={pageUrl('home', 'en')}>
        <span>{t('en', 'notFound.home')}</span>
        <Icon name="arrow" />
      </a>
    </div>
  </StageMessage>
</BaseLayout>

<style>
  .not-found__code {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: 0.3em;
  }

  .not-found__en {
    max-width: 32rem;
    margin: 2.5rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.3);
    font-size: var(--fs-small);
  }

  .not-found__en p {
    margin-bottom: 0.75rem;
  }
</style>
