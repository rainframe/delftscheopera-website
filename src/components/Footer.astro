---
const currentYear = new Date().getFullYear();
---

<footer class="bg-[var(--color-footer-bg)] text-[var(--color-footer-text)] pt-12 pb-8 border-t border-black/10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Info DOC -->
      <div>
        <h3 class="font-['Roboto_Condensed'] text-xl font-bold text-white mb-3 tracking-wide">
          Stichting Delftsche Opera Compagnie
        </h3>
        <p class="text-sm text-gray-300 leading-relaxed mb-4">
          Al meer dan 25 jaar organisator van monumentale muziektheater- en operaproducties voor het Delftse studentenorkest en -koor Krashna Musika.
        </p>
        <a 
          href="https://www.krashna.nl" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center text-sm text-[var(--color-primary-light)] hover:text-white underline underline-offset-4"
        >
          Bezoek Krashna Musika &rarr;
        </a>
      </div>

      <!-- Snelle links -->
      <div>
        <h3 class="font-['Roboto_Condensed'] text-lg font-bold text-white mb-3 tracking-wide">
          Navigatie
        </h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-white hover:underline">Home</a></li>
          <li><a href="/producties" class="hover:text-white hover:underline">Producties</a></li>
          <li><a href="/organisatie" class="hover:text-white hover:underline">Organisatie & Beleid</a></li>
          <li><a href="/contact" class="hover:text-white hover:underline">Contact & Bestuur</a></li>
        </ul>
      </div>

      <!-- Contact & ANBI / Gegevens -->
      <div>
        <h3 class="font-['Roboto_Condensed'] text-lg font-bold text-white mb-3 tracking-wide">
          Contact & Gegevens
        </h3>
        <p class="text-sm text-gray-300 mb-1">
          <strong>Adres:</strong> Mekelweg 10, 2628CD Delft
        </p>
        <p class="text-sm text-gray-300 mb-1">
          <strong>E-mail:</strong> <a href="mailto:info@stichtingdoc.nl" class="hover:text-white underline">info@stichtingdoc.nl</a>
        </p>
        <p class="text-sm text-gray-300 mb-1">
          <strong>KvK:</strong> 41146911
        </p>
        <p class="text-sm text-gray-300">
          <strong>RSIN:</strong> 8036313217
        </p>
      </div>
    </div>

    <!-- Copyright -->
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-400 gap-4">
      <p>&copy; {currentYear} Stichting Delftsche Opera Compagnie. Alle rechten voorbehouden.</p>
      <div class="flex items-center gap-4">
        <a href="/contact" class="hover:text-gray-200">Contact</a>
        <span>&bull;</span>
        <a href="/keystatic" class="hover:text-gray-200" title="Beheerder login">CMS Editor</a>
      </div>
    </div>
  </div>
</footer>
