---
/**
 * De grote banner uit het ontwerp (de Community Opera 2028 op de homepage): foto tussen twee
 * gordijnen, met logo, titel en ondertitel eroverheen. Met `href` wordt de hele banner een link.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CurtainFrame from './CurtainFrame.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import type { Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  subtitle: string;
  images: { image: ImageMetadata; imageAlt: string; credit?: string; mobileFocus?: number }[];
  href?: string;
  linkLabel?: string;
  headingLevel?: 'h1' | 'h2' | 'h3';
  /** Kleur van het vlak rond de banner (en dus van de gordijnen). */
  tone?: 'navy' | 'white';
  eager?: boolean;
}

const {
  locale,
  title,
  subtitle,
  images,
  href,
  linkLabel,
  headingLevel = 'h2',
  tone = 'navy',
  eager = false,
} = Astro.props;
const Heading = headingLevel;
---

<stage-carousel
  class:list={['stage', `stage--${tone}`]}
  role="region"
  aria-roledescription={t(locale, 'carousel.label')}
  aria-label={title}
  data-pause-label={t(locale, 'carousel.pause')}
  data-play-label={t(locale, 'carousel.play')}
>
  <CurtainFrame sides="both" tone={tone} class="stage__frame">
    {images.map(({ image, imageAlt, credit, mobileFocus = 50 }, index) => (
      <div
        class:list={['stage__slide', { 'is-active': index === 0 }]}
        data-slide
        role="group"
        aria-roledescription={t(locale, 'carousel.slide')}
        aria-label={`${index + 1} / ${images.length}`}
        aria-hidden={index !== 0}
        style={`--mobile-position: ${mobileFocus}% center`}
      >
        <Image
          src={image}
          alt={imageAlt}
          layout="full-width"
          loading={eager && index === 0 ? 'eager' : 'lazy'}
          fetchpriority={eager && index === 0 ? 'high' : undefined}
        />
        {credit && (
          <p class="stage__credit">
            {t(locale, 'photo.credit')}: {credit}
          </p>
        )}
      </div>
    ))}
    <div class="stage__overlay">
      <Logo class="stage__logo" color="white" alt="" width={132} />
      <Heading class="stage__title">{title}</Heading>
      <p class="stage__subtitle">{subtitle}</p>
      {href && (
        <a class="stage__link" href={href}>
          <Icon name="arrow" />
          <span class="visually-hidden">{linkLabel ?? title}</span>
        </a>
      )}
    </div>
  </CurtainFrame>
  {images.length > 1 && (
    <div class="stage__controls" data-controls hidden>
      <button type="button" data-previous aria-label={t(locale, 'carousel.previous')}>
        <span aria-hidden="true">‹</span>
      </button>
      {images.map((_, index) => (
        <button
          type="button"
          class="stage__dot"
          data-go-to={index}
          aria-label={`${t(locale, 'carousel.goTo')} ${index + 1}`}
          aria-current={index === 0 ? 'true' : 'false'}
        >
          <span aria-hidden="true" />
        </button>
      ))}
      <button type="button" data-next aria-label={t(locale, 'carousel.next')}>
        <span aria-hidden="true">›</span>
      </button>
      <button type="button" data-play aria-label={t(locale, 'carousel.pause')}>
        <span data-play-icon aria-hidden="true">
          Ⅱ
        </span>
      </button>
    </div>
  )}
  <p class="visually-hidden" data-status aria-live="polite" aria-atomic="true" />
</stage-carousel>

<script>
  class StageCarousel extends HTMLElement {
    connectedCallback() {
      const slides = Array.from(this.querySelectorAll<HTMLElement>('[data-slide]'));
      const controls = this.querySelector<HTMLElement>('[data-controls]');
      if (slides.length < 2 || !controls) return;

      const dots = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-go-to]'));
      const play = this.querySelector<HTMLButtonElement>('[data-play]')!;
      const playIcon = this.querySelector<HTMLElement>('[data-play-icon]')!;
      const status = this.querySelector<HTMLElement>('[data-status]')!;
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const events = new AbortController();
      let current = 0;
      let paused = motion.matches;
      let hovering = false;
      let pointerPlayState: boolean | undefined;
      let timer: ReturnType<typeof setTimeout> | undefined;

      const schedule = () => {
        clearTimeout(timer);
        if (!paused && !hovering && !document.hidden) {
          timer = setTimeout(() => show(current + 1), 6000);
        }
      };
      const updatePlay = () => {
        play.setAttribute('aria-label', (paused ? this.dataset.playLabel : this.dataset.pauseLabel)!);
        playIcon.textContent = paused ? '▶' : 'Ⅱ';
        schedule();
      };
      const show = (index: number, manual = false) => {
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          slide.classList.toggle('is-active', i === current);
          slide.setAttribute('aria-hidden', String(i !== current));
          dots[i].setAttribute('aria-current', String(i === current));
        });
        if (manual) {
          paused = true;
          status.textContent = `${current + 1} / ${slides.length}: ${slides[current].querySelector('img')!.alt}`;
        }
        updatePlay();
      };

      controls.hidden = false;
      // Bewaar de bedoelde actie voordat focus de carrousel automatisch pauzeert.
      play.addEventListener(
        'pointerdown',
        () => {
          pointerPlayState = !paused;
        },
        { signal: events.signal },
      );
      play.addEventListener(
        'pointercancel',
        () => {
          pointerPlayState = undefined;
        },
        { signal: events.signal },
      );
      controls.addEventListener(
        'click',
        (event) => {
          const button = (event.target as HTMLElement).closest('button');
          if (!button) return;
          if (button.hasAttribute('data-play')) {
            paused = event.detail > 0 ? (pointerPlayState ?? !paused) : !paused;
            pointerPlayState = undefined;
            updatePlay();
          } else if (button.hasAttribute('data-previous')) show(current - 1, true);
          else if (button.hasAttribute('data-next')) show(current + 1, true);
          else if (button.dataset.goTo !== undefined) show(Number(button.dataset.goTo), true);
        },
        { signal: events.signal },
      );
      controls.addEventListener(
        'keydown',
        (event) => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault();
          show(current + (event.key === 'ArrowLeft' ? -1 : 1), true);
        },
        { signal: events.signal },
      );
      this.addEventListener(
        'mouseenter',
        () => {
          hovering = true;
          schedule();
        },
        { signal: events.signal },
      );
      this.addEventListener(
        'mouseleave',
        () => {
          hovering = false;
          schedule();
        },
        { signal: events.signal },
      );
      this.addEventListener(
        'focusin',
        () => {
          paused = true;
          updatePlay();
        },
        { signal: events.signal },
      );
      document.addEventListener('visibilitychange', schedule, { signal: events.signal });
      motion.addEventListener(
        'change',
        () => {
          if (motion.matches) paused = true;
          updatePlay();
        },
        { signal: events.signal },
      );
      updatePlay();
      this.cleanup = () => {
        clearTimeout(timer);
        events.abort();
      };
    }

    private cleanup?: () => void;

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get('stage-carousel')) customElements.define('stage-carousel', StageCarousel);
</script>

<style>
  .stage {
    display: block;
    --curtain-w: clamp(2rem, 9.8%, 9rem);
    padding-block: clamp(2.5rem, 6vw, 5.25rem);
  }

  .stage--navy {
    background: var(--navy);
  }

  .stage :global(.stage__frame) {
    max-width: 90rem;
    margin-inline: auto;
    aspect-ratio: 2.3;
    color: var(--navy);
  }

  .stage--white :global(.stage__frame) {
    color: var(--white);
  }

  .stage__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.7s ease,
      visibility 0.7s;
  }

  .stage__slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .stage__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stage__controls {
    display: flex;
    justify-content: center;
    margin-top: 0.75rem;
    color: var(--white);
  }

  .stage__controls[hidden] {
    display: none;
  }

  .stage--white .stage__controls {
    color: var(--navy);
  }

  .stage__controls button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: inherit;
    background: transparent;
    font-size: 1.75rem;
    cursor: pointer;
  }

  .stage__controls button:hover {
    background: rgb(255 255 255 / 0.15);
  }

  .stage__dot span {
    width: 10px;
    height: 10px;
    border: 1px solid currentColor;
    border-radius: 50%;
  }

  .stage__dot[aria-current='true'] span {
    background: currentColor;
  }

  .stage__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem calc(var(--curtain-w) + 1rem);
    color: var(--white);
    text-align: center;
    background: radial-gradient(ellipse at center, rgb(0 0 0 / 0.28), rgb(0 0 0 / 0.08) 70%);
    pointer-events: none;
  }

  .stage__overlay :global(.stage__logo) {
    width: clamp(78px, 9.7vw, 132px);
    height: auto;
    margin-bottom: clamp(0.5rem, 1.6vw, 1.5rem);
  }

  .stage__title {
    /* Op smalle telefoons kleiner, zodat een lang woord als "Community" tussen de gordijnen past. */
    font-size: min(var(--fs-mega), 13vw);
    line-height: 0.9;
    text-shadow: 0 3px 30px rgb(0 0 0 / 0.35);
  }

  .stage__subtitle {
    margin-top: 0.35em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 5vw, 4.25rem);
    line-height: 1;
    text-shadow: 0 2px 20px rgb(0 0 0 / 0.35);
  }

  .stage__link {
    pointer-events: auto;
    display: inline-flex;
    margin-top: clamp(0.6rem, 1.8vw, 1.4rem);
    font-size: clamp(1.9rem, 3.8vw, 3.25rem);
    color: var(--white);
    transition: transform 0.2s ease;
  }

  /* De hele banner is klikbaar via de pijl-link. */
  .stage__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .stage__link:hover {
    transform: translateX(0.2em);
  }

  .stage__link:focus-visible {
    outline: none;
  }

  .stage__link:focus-visible::after {
    outline: 3px solid var(--white);
    outline-offset: -8px;
  }

  .stage__credit {
    position: absolute;
    z-index: 3;
    right: calc(var(--curtain-w) * 0.78 + 0.5rem);
    bottom: 0.55rem;
    color: var(--white);
    padding: 0.2rem 0.4rem;
    border-radius: 2px;
    background: rgb(0 0 0 / 0.45);
    font-size: var(--fs-tiny);
    line-height: 1.2;
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.6);
  }

  @media (max-width: 64rem) {
    .stage :global(.stage__frame) {
      aspect-ratio: 3 / 2;
    }
  }

  @media (max-width: 40rem) {
    .stage__slide img {
      object-position: var(--mobile-position, center);
    }

    .stage :global(.stage__frame) {
      aspect-ratio: 4 / 5;
    }

    .stage {
      --curtain-w: 2.4rem;
    }

    .stage__credit {
      right: 50%;
      transform: translateX(50%);
      white-space: nowrap;
    }
  }
</style>
