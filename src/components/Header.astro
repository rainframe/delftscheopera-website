---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/producties', label: 'Producties' },
  { href: '/organisatie', label: 'Organisatie' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="bg-[var(--color-header-bg)] text-[var(--color-header-text)] shadow-md sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Site Title / Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-full bg-[var(--color-primary)] flex items-center justify-center font-bold text-white text-lg tracking-wider group-hover:scale-105 transition-transform">
          DOC
        </div>
        <div>
          <span class="font-['Roboto_Condensed'] text-xl sm:text-2xl font-bold tracking-tight block text-white">
            Stichting Delftsche Opera Compagnie
          </span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex space-x-1 sm:space-x-2" aria-label="Hoofdnavigatie">
        {navItems.map((item) => {
          const isActive = pathname === item.href;
          return (
            <a
              href={item.href}
              class={`px-4 py-2 rounded text-base font-semibold transition-colors relative ${
                isActive
                  ? 'text-white after:content-[""] after:absolute after:bottom-0 after:left-4 after:right-4 after:h-1 after:bg-[var(--color-primary)]'
                  : 'text-gray-200 hover:text-white hover:bg-white/10'
              }`}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Mobile Menu Button -->
      <div class="flex md:hidden">
        <button
          type="button"
          id="mobile-menu-btn"
          class="p-2 rounded-md text-gray-200 hover:text-white hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]"
          aria-expanded="false"
          aria-label="Menu openen"
        >
          <svg id="menu-icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-white/10 bg-[var(--color-header-bg)] px-4 pt-2 pb-4 space-y-1">
    {navItems.map((item) => {
      const isActive = pathname === item.href;
      return (
        <a
          href={item.href}
          class={`block px-3 py-2 rounded-md text-base font-medium ${
            isActive
              ? 'bg-[var(--color-primary)] text-white'
              : 'text-gray-200 hover:text-white hover:bg-white/10'
          }`}
        >
          {item.label}
        </a>
      );
    })}
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  if (button && menu && openIcon && closeIcon) {
    button.addEventListener('click', () => {
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });
  }
</script>
