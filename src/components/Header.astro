---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { mainNav, pageUrl, type Alternates, type Locale, type RouteKey } from '@/i18n/routes';
import { navLabel, t } from '@/i18n/ui';

interface Props {
  locale: Locale;
  alternates: Alternates;
  current?: RouteKey;
}

const { locale, alternates, current } = Astro.props;

const languages = [
  { code: 'nl', label: t(locale, 'lang.nl'), href: alternates.nl ?? pageUrl('home', 'nl') },
  { code: 'en', label: t(locale, 'lang.en'), href: alternates.en ?? pageUrl('home', 'en') },
] as const;
---

<header class="site-header" data-menu="closed">
  <div class="site-header__inner container container--wide">
    <a class="site-header__logo" href={pageUrl('home', locale)}>
      <Logo color="navy" alt="Delftsche Opera – home" width={180} />
    </a>

    <nav id="hoofdmenu" class="main-nav" aria-label={t(locale, 'nav.label')}>
      <ul>
        {mainNav.map((key) => (
          <li>
            <a href={pageUrl(key, locale)} aria-current={current === key ? 'page' : undefined}>
              {navLabel(locale, key)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <ul class="lang-switch" aria-label={t(locale, 'lang.label')}>
      {languages.map((lang) => (
        <li>
          <a
            href={lang.href}
            hreflang={lang.code}
            lang={lang.code}
            aria-current={lang.code === locale ? 'true' : undefined}
          >
            <span aria-hidden="true">{lang.code.toUpperCase()}</span>
            <span class="visually-hidden">{lang.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="hoofdmenu"
      data-label-open={t(locale, 'nav.open')}
      data-label-close={t(locale, 'nav.close')}
    >
      <Icon name="menu" class="menu-toggle__open" />
      <Icon name="close" class="menu-toggle__close" />
      <span class="visually-hidden">{t(locale, 'nav.open')}</span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const label = toggle?.querySelector('.visually-hidden');

  function setOpen(open: boolean) {
    if (!header || !toggle) return;
    header.dataset.menu = open ? 'open' : 'closed';
    toggle.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
  }

  toggle?.addEventListener('click', () => setOpen(header?.dataset.menu !== 'open'));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && header?.dataset.menu === 'open') {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    background: var(--white);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 3rem);
    padding-block: clamp(1rem, 4vw, 3.4rem);
  }

  .site-header__logo {
    flex: none;
    margin-right: auto;
  }

  .site-header__logo img {
    width: clamp(118px, 13.2vw, 180px);
    height: auto;
  }

  .main-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem clamp(1.5rem, 4.2vw, 4rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .main-nav a {
    display: inline-block;
    padding-block: 0.25rem;
    font-size: clamp(1.1rem, 1.55vw, 1.35rem);
    line-height: 1.2;
    text-decoration: none;
  }

  .main-nav a:hover,
  .main-nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  /* Taalkeuze als schakelaar: de huidige taal is marineblauw gevuld. */
  .lang-switch {
    display: flex;
    flex: none;
    margin: 0;
    padding: 3px;
    border: 2px solid var(--navy);
    border-radius: 999px;
    list-style: none;
  }

  .lang-switch a {
    display: block;
    min-width: 2.75rem;
    padding: 0.5rem 0.625rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.08em;
    text-align: center;
    text-decoration: none;
  }

  .lang-switch a:hover {
    background: rgb(var(--navy-rgb) / 0.1);
  }

  .lang-switch a[aria-current='true'] {
    background: var(--navy);
    color: var(--white);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--navy);
    font-size: 1.75rem;
    cursor: pointer;
  }

  .menu-toggle :global(.menu-toggle__close) {
    display: none;
  }

  /* Smalle schermen: menu achter een knop (alleen als JavaScript werkt). */
  @media (max-width: 60rem) {
    .site-header__inner {
      flex-wrap: wrap;
      column-gap: 1rem;
    }

    .main-nav {
      order: 3;
      flex-basis: 100%;
    }

    :global(.js) .menu-toggle {
      display: inline-flex;
    }

    :global(.js) .main-nav {
      display: none;
    }

    :global(.js) .site-header[data-menu='open'] .main-nav {
      display: block;
    }

    :global(.js) .site-header[data-menu='open'] .menu-toggle :global(.menu-toggle__open) {
      display: none;
    }

    :global(.js) .site-header[data-menu='open'] .menu-toggle :global(.menu-toggle__close) {
      display: block;
    }

    .main-nav ul {
      flex-direction: column;
      gap: 0;
      padding-block: 0.5rem 0.75rem;
      border-top: 2px solid var(--navy);
    }

    .main-nav a {
      display: block;
      padding-block: 0.7rem;
      font-size: 1.4rem;
    }
  }
</style>
