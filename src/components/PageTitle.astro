---
/** Grote gecentreerde paginatitel zoals "Projecten" in het ontwerp, met optionele tekst eronder. */
interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<header class:list={['page-title', className]}>
  <div class="container">
    <h1 class="display-title">{title}</h1>
    <slot />
  </div>
</header>

<style>
  .page-title {
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2.5rem, 6vw, 5rem);
  }
</style>
