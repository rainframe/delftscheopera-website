---
/**
 * Het theatergordijn uit het logo, als los vlak. Standaard een linkergordijn
 * (rechte kant links, gebogen kant rechts); `side="right"` spiegelt het.
 * De kleur volgt `color` van het omringende element (currentColor).
 */
interface Props {
  side?: 'left' | 'right';
  class?: string;
}

const { side = 'left', class: className } = Astro.props;

// Vorm overgetrokken uit het ontwerp; viewBox 0 0 237.6 1000.
const path =
  'M0 0V1000H173.3V995.7C173.3 970.4 163.4 901.6 151.6 844.3 127.6 727.6 100.5 608 92 581.3 91.6 579.8 89.8 573.3 88.2 566.7 82.8 545.1 76.2 528.2 69.2 517.6 67.2 514.6 65.5 511.8 65.5 511.4 65.5 510.7 65.9 510.2 75.7 498.1 78.8 494.2 84.2 487.3 87.6 482.7 91.1 478.1 97.5 469.8 102 464.2 136.5 420.9 168.3 366.9 184.6 324 193.7 300.1 205.9 255.7 212 223.9 232.9 116.2 237.6 78.3 237.6 17.4V0Z';
---

<svg
  class:list={['curtain', `curtain--${side}`, className]}
  viewBox="0 0 237.6 1000"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <path fill="currentColor" d={path} transform={side === 'right' ? 'matrix(-1 0 0 1 237.6 0)' : undefined}></path>
</svg>
