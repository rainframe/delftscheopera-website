---
/**
 * Het theatergordijn uit het logo, als los vlak. Standaard een linkergordijn
 * (rechte kant links, gebogen kant rechts); `side="right"` spiegelt het.
 * De kleur volgt `color` van het omringende element (currentColor).
 */
import { curtainPath, curtainViewBox } from '@/lib/curtain';

interface Props {
  side?: 'left' | 'right';
  class?: string;
}

const { side = 'left', class: className } = Astro.props;
const { width, height } = curtainViewBox;
---

<svg
  class:list={['curtain', `curtain--${side}`, className]}
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    fill="currentColor"
    d={curtainPath}
    transform={side === 'right' ? `matrix(-1 0 0 1 ${width} 0)` : undefined}
  ></path>
</svg>
