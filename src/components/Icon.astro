---
/** Kleine iconen; nemen de tekstkleur over. */
interface Props {
  name: 'arrow' | 'instagram' | 'linkedin' | 'mail' | 'rss' | 'menu' | 'close';
  class?: string;
  label?: string;
}

const { name, class: className, label } = Astro.props;
---

<svg
  class:list={['icon', `icon--${name}`, className]}
  viewBox="0 0 24 24"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {name === 'arrow' && <path fill="currentColor" d="M3 2.5 22 12 3 21.5l4.2-9.5z" />}
  {name === 'instagram' && (
    <g fill="none" stroke="currentColor" stroke-width="2">
      <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
      <circle cx="12" cy="12" r="4.3" />
      <circle cx="17.4" cy="6.6" r="0.6" fill="currentColor" stroke-width="1.3" />
    </g>
  )}
  {name === 'linkedin' && (
    <g fill="currentColor">
      <rect
        x="2.5"
        y="2.5"
        width="19"
        height="19"
        rx="4.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      />
      <circle cx="8.1" cy="8" r="1.4" />
      <path d="M6.9 10.3h2.4v7.3H6.9zM11.2 10.3h2.3v1c.4-.7 1.3-1.2 2.5-1.2 2 0 2.8 1.3 2.8 3.4v4.1h-2.4v-3.7c0-1-.3-1.7-1.3-1.7s-1.5.7-1.5 1.8v3.6h-2.4z" />
    </g>
  )}
  {name === 'mail' && (
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
      <rect x="2.5" y="5" width="19" height="14" rx="1.5" />
      <path d="m3 6 9 7 9-7" />
    </g>
  )}
  {name === 'rss' && (
    <g fill="currentColor">
      <circle cx="6" cy="18" r="2" />
      <path d="M4 10.5a9.5 9.5 0 0 1 9.5 9.5h-2.6A6.9 6.9 0 0 0 4 13.1zM4 4.5A15.5 15.5 0 0 1 19.5 20h-2.6A12.9 12.9 0 0 0 4 7.1z" />
    </g>
  )}
  {name === 'menu' && (
    <g stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
      <path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17" />
    </g>
  )}
  {name === 'close' && (
    <g stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
      <path d="m5.5 5.5 13 13m0-13-13 13" />
    </g>
  )}
</svg>

<style>
  .icon {
    width: 1em;
    height: 1em;
    flex: none;
  }
</style>
