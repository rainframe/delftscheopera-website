---
import { Image } from 'astro:assets';
import CurtainFrame from './CurtainFrame.astro';
import CurtainMark from './CurtainMark.astro';
import type { Locale } from '@/i18n/routes';
import { formatDate, t } from '@/i18n/ui';
import type { Post } from '@/lib/content';

interface Props {
  post: Post;
  /** Taal van de pagina waarop de kaart staat. */
  locale: Locale;
  /** Achtergrond waarop de kaart staat; bepaalt de kleur van de gordijnen. */
  tone?: 'navy' | 'white';
  headingLevel?: 'h2' | 'h3';
  size?: 'default' | 'large';
  /** Direct laden (voor een kaart bovenaan de pagina). */
  eager?: boolean;
}

const { post, locale, tone = 'white', headingLevel = 'h3', size = 'default', eager = false } = Astro.props;
const { title, summary, date, cover } = post.entry.data;
const Heading = headingLevel;
const otherLanguage = post.locale !== locale;
---

<article class:list={['post-card', `post-card--${tone}`, `post-card--${size}`]}>
  <div class="post-card__media">
    {cover ? (
      <CurtainFrame sides="both" tone={tone} curtainWidth="10%">
        <Image
          src={cover}
          alt=""
          loading={eager ? 'eager' : 'lazy'}
          widths={size === 'large' ? [480, 800, 1200, 1600] : [400, 640, 900]}
          sizes={
            size === 'large'
              ? '(min-width: 64rem) 55vw, 100vw'
              : '(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw'
          }
        />
      </CurtainFrame>
    ) : (
      <CurtainMark />
    )}
  </div>
  <div class="post-card__body">
    <p class="post-card__meta">
      <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date, locale)}</time>
      {otherLanguage && <span class="post-card__badge">{t(locale, 'news.dutchOnly')}</span>}
    </p>
    <Heading class="post-card__title" lang={otherLanguage ? post.locale : undefined}>
      <a href={post.url} hreflang={otherLanguage ? post.locale : undefined}>
        {title}
      </a>
    </Heading>
    <p class="post-card__summary" lang={otherLanguage ? post.locale : undefined}>
      {summary}
    </p>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .post-card__media :global(.curtain-frame),
  .post-card__media :global(.curtain-mark) {
    aspect-ratio: 3 / 2;
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    font-size: var(--fs-small);
  }

  .post-card__badge {
    padding: 0.1em 0.55em;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: var(--fs-tiny);
  }

  .post-card__title {
    margin-top: 0.4rem;
    font-size: var(--fs-h3);
    line-height: 1.12;
  }

  .post-card__title a {
    text-decoration: none;
  }

  /* De hele kaart is klikbaar via de titel-link. */
  .post-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post-card:hover .post-card__title a {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .post-card__title a:focus-visible {
    outline: none;
  }

  .post-card__title a:focus-visible::after {
    outline: 3px solid currentColor;
    outline-offset: 6px;
  }

  .post-card__summary {
    margin-top: 0.6rem;
    line-height: 1.5;
  }

  .post-card--large {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .post-card--large .post-card__title {
    font-size: var(--fs-h2);
  }

  .post-card--large .post-card__summary {
    font-size: var(--fs-lead);
  }

  @media (max-width: 48rem) {
    .post-card--large {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
