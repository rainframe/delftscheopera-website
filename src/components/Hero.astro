---
/** Brede foto met navy waas en grote witte titel ("Steun ons!" in het ontwerp). */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  title: string;
  subtitle: string;
  intro?: string;
  image: ImageMetadata;
  imageAlt: string;
  link?: { href: string; label: string };
  /** Op de homepage is de paginatitel (h1) de sitenaam; daar is de hero-titel een h2. */
  headingLevel?: 'h1' | 'h2';
}

const { title, subtitle, intro, image, imageAlt, link, headingLevel = 'h1' } = Astro.props;
const Heading = headingLevel;
---

<section class="hero band">
  <Image
    class="hero__image"
    src={image}
    alt={imageAlt}
    layout="full-width"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__inner">
    {intro && <p class="hero__intro">{intro}</p>}
    <div class="hero__content">
      <Heading class="hero__title">{title}</Heading>
      <p class="hero__subtitle">{subtitle}</p>
      {link && (
        <a class="arrow-link hero__link" href={link.href}>
          <span>{link.label}</span>
          <Icon name="arrow" />
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Navy waas over de foto, zoals in het ontwerp. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(var(--navy-rgb) / 0.58);
  }

  .hero__inner {
    position: relative;
    display: grid;
    align-content: center;
    min-height: clamp(21rem, 27.6vw, 27rem);
    padding: clamp(2.5rem, 5vw, 3.5rem) var(--gutter);
  }

  .hero__content {
    text-align: center;
  }

  .hero__title {
    font-size: var(--fs-hero);
    line-height: 0.95;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.2);
  }

  .hero__subtitle {
    margin-top: 0.45em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-hero-sub);
    line-height: 1.15;
    text-wrap: balance;
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.25);
  }

  .hero__link {
    margin-top: clamp(1.1rem, 2.4vw, 1.75rem);
    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
  }

  .hero__intro {
    max-width: 30rem;
    margin-bottom: 1.5rem;
    font-size: var(--fs-small);
    line-height: 1.45;
  }

  @media (min-width: 64rem) {
    .hero__intro {
      position: absolute;
      top: 1.6rem;
      left: var(--gutter);
      margin: 0;
    }

    .hero__inner {
      padding-top: 4.5rem;
    }
  }
</style>
