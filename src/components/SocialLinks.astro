---
import Icon from './Icon.astro';
import type { Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { getSettings } from '@/lib/content';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const { socials } = await getSettings();

const links = [
  { name: 'instagram', href: socials.instagram, label: t(locale, 'social.instagram') },
  { name: 'linkedin', href: socials.linkedin, label: t(locale, 'social.linkedin') },
] as const;
---

<ul class:list={['social-links', className]}>
  {links
    .filter((link) => link.href)
    .map((link) => (
      <li>
        <a href={link.href} rel="me noopener" aria-label={link.label}>
          <Icon name={link.name} />
        </a>
      </li>
    ))}
</ul>

<style>
  .social-links {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 3.5rem;
  }

  .social-links a {
    display: block;
    line-height: 0;
    transition: opacity 0.15s ease;
  }

  .social-links a:hover {
    opacity: 0.75;
  }
</style>
