// Cloudflare Workers: de gebouwde site (dist/) wordt als statische bestanden geserveerd. De worker
// (worker/index.ts) kiest per domein wat er getoond wordt en handelt het inloggen in het beheer af.
{
  "name": "delftscheopera-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Onbekende adressen krijgen de 404-pagina ("Het doek is gevallen").
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // De worker komt vóór de bestanden, zodat hij per domein kan kiezen (bouwpagina, preview,
    // doorverwijzingen, inloggen). Alleen /_astro/ (bestanden met een hash in de naam) gaat er
    // rechtstreeks omheen.
    "run_worker_first": ["/*", "!/_astro/*"]
  },
  // De site is alleen via de eigen domeinen bereikbaar (in Cloudflare aan de worker gekoppeld), niet
  // via *.workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // Client ID van de GitHub OAuth-app. Die is openbaar en hoort hier te staan: variabelen in dit
    // bestand overschrijven bij elke deploy wat in het Cloudflare-dashboard is ingesteld. Het
    // bijbehorende secret (GITHUB_CLIENT_SECRET) staat alleen als "Secret" in Cloudflare.
    "GITHUB_CLIENT_ID": "Ov23li2hQ7G9sM5BR3pm"
  }
}
