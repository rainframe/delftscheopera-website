{
  "name": "delftscheopera-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Website van Stichting Delftsche Opera Compagnie (delftscheopera.nl)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/copy-cms.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/copy-cms.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && node scripts/check-cms.mjs",
    "check:cms": "node scripts/check-cms.mjs",
    "format": "prettier --write .",
    "astro": "astro"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/league-spartan": "^5.3.0",
    "@sveltia/cms": "^0.221.6",
    "astro": "^7.3.5",
    "marked": "^18.0.14",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
